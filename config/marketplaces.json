{
  "schema_version": 1,
  "currency": "JPY",
  "search_template_note": "検索URLは出品を探すためのリンクであり、価格・在庫の観測データではない。",
  "allowed_domains": [
    "amazon.co.jp",
    "jp.mercari.com",
    "mercari.com",
    "search.rakuten.co.jp",
    "item.rakuten.co.jp",
    "shopping.rakuten.co.jp",
    "shopping.yahoo.co.jp",
    "store.shopping.yahoo.co.jp",
    "auctions.yahoo.co.jp",
    "shopping.bookoff.co.jp",
    "suruga-ya.jp",
    "netoff.co.jp",
    "mandarake.co.jp"
  ],
  "marketplaces": [
    {
      "id": "amazon-jp",
      "name": "Amazon.co.jp",
      "search_template": "https://www.amazon.co.jp/s?k={query}",
      "enabled": true
    },
    {
      "id": "mercari",
      "name": "メルカリ",
      "search_template": "https://jp.mercari.com/search?keyword={query}",
      "enabled": true
    },
    {
      "id": "rakuten",
      "name": "楽天市場",
      "search_template": "https://search.rakuten.co.jp/search/mall/{query}/",
      "enabled": true
    },
    {
      "id": "yahoo-shopping",
      "name": "Yahoo!ショッピング",
      "search_template": "https://shopping.yahoo.co.jp/search?p={query}",
      "enabled": true
    },
    {
      "id": "yahoo-auctions",
      "name": "Yahoo!オークション",
      "search_template": "https://auctions.yahoo.co.jp/search/search?p={query}",
      "enabled": true
    },
    {
      "id": "bookoff",
      "name": "BOOKOFFオンライン",
      "search_template": "https://shopping.bookoff.co.jp/search/keyword/{query}",
      "enabled": true
    },
    {
      "id": "suruga-ya",
      "name": "駿河屋（サイト内検索）",
      "search_template": "https://www.google.com/search?q=site%3Asuruga-ya.jp+{query}",
      "enabled": true
    },
    {
      "id": "netoff",
      "name": "ネットオフ（サイト内検索）",
      "search_template": "https://www.google.com/search?q=site%3Anettof.co.jp+{query}",
      "enabled": true
    }
  ],
  "discovery": {
    "max_queries_per_run": 25,
    "max_candidates_per_manga": 8,
    "delay_seconds": 0.15,
    "timeout_seconds": 3,
    "max_response_bytes": 2000000,
    "engine_urls": [
      "https://www.bing.com/search?q={query}&mkt=ja-JP&setlang=ja"
    ],
    "search_targets": [
      {
        "id": "mercari",
        "domain": "jp.mercari.com",
        "query_template": "site:jp.mercari.com/item \"{title}\" 中古 全巻セット",
        "search_page_template": "https://jp.mercari.com/search?keyword={query}",
        "search_term_template": "{title}"
      },
      {
        "id": "bookoff",
        "domain": "shopping.bookoff.co.jp",
        "query_template": "site:shopping.bookoff.co.jp/used \"{title}\" 全巻セット 中古",
        "search_page_template": "https://shopping.bookoff.co.jp/search/keyword/{query}",
        "search_term_template": "{title}"
      },
      {
        "id": "yahoo-auctions",
        "domain": "auctions.yahoo.co.jp",
        "query_template": "site:auctions.yahoo.co.jp \"{title}\" 全巻セット 中古",
        "search_page_template": "https://auctions.yahoo.co.jp/search/search?p={query}",
        "search_term_template": "{title}"
      },
      {
        "id": "rakuten",
        "domain": "item.rakuten.co.jp",
        "query_template": "site:item.rakuten.co.jp \"{title}\" 全巻セット 中古",
        "search_page_template": "https://search.rakuten.co.jp/search/mall/{query}/",
        "search_term_template": "{title}"
      }
    ],
    "max_candidates_per_target": 2
  },
  "monitor": {
    "timeout_seconds": 10,
    "max_response_bytes": 3000000,
    "max_price_age_hours": 24,
    "max_cost_check_age_days": 7,
    "max_auto_watch_candidates": 25,
    "max_auto_candidates_per_manga": 1,
    "request_delay_seconds": 0.8,
    "user_agent": "manga-Buy/0.1 (+https://github.com/sasasotaro1202-star/manga-Buy)"
  }
}
